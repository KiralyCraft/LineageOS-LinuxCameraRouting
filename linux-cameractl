#!/usr/bin/env python3
"""Inspect genuine linux-camera V4L2 nodes without starting capture."""
import argparse
import pathlib
import subprocess
import sys

parser = argparse.ArgumentParser()
parser.add_argument('operation', choices=['list', 'status', 'diagnostics'], nargs='?', default='status')
args = parser.parse_args()
found = False
for node in sorted(pathlib.Path('/sys/class/video4linux').glob('video*')):
    name = (node / 'name').read_text().strip()
    if not name.startswith('Linux Camera '):
        continue
    found = True
    device = '/dev/' + node.name
    print(f'{device}: {name}', flush=True)
    if args.operation != 'list':
        command = ['v4l2-ctl', '-d', device, '--all']
        if args.operation == 'diagnostics':
            command.append('--list-formats-ext')
        subprocess.run(command, check=False)
if not found:
    print('No Linux camera nodes. Enable Linux Camera on Android; check the Magisk module if startup fails.')
    sys.exit(1)
